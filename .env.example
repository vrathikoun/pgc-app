# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/pgc_app

# Sécurité JWT
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Stripe (paiements)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
APP_NAME=PGC
DEBUG=True

# Email SMTP (Brevo recommandé : 300 emails/jour gratuits)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=ton@email.com
SMTP_PASSWORD=ta_cle_api_brevo
EMAIL_FROM=noreply@tonclub.com

# Push notifications (Firebase Cloud Messaging)
# JSON complet du compte de service Firebase, sur UNE seule ligne (échappe les sauts de ligne en \n).
# Vide => les push sont seulement loguées, jamais envoyées.
FIREBASE_CREDENTIALS_JSON=

# Secret partagé protégeant l'endpoint des rappels 24h (POST /tasks/send-reminders)
# Le cron externe doit l'envoyer dans l'en-tête X-Cron-Secret.
CRON_SECRET=change-this-too

